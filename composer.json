{
  "name": "dkkoma/php-grpc-lite-gax",
  "description": "GAX TransportInterface adapters for FrankenPHP grpc-go and php-grpc-lite backends.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "google/gax": "^1.42.3"
  },
  "require-dev": {
    "google/cloud-spanner": "^2.7",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^4.0",
    "google/cloud-pubsub": "^2.19"
  },
  "suggest": {
    "cweagans/composer-patches": "Apply patches/google-gax-transport-factory.patch in applications that use transportFactory.",
    "dkkoma/php-grpc-lite": "Install the PIE php-grpc-lite grpc extension for GrpcLiteTransport::build()."
  },
  "extra": {
    "patches": {
      "google/gax": {
        "Add transportFactory option for custom TransportInterface construction": "patches/google-gax-transport-factory.patch"
      }
    }
  },
  "autoload": {
    "psr-4": {
      "GrpcLiteGax\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GrpcLiteGax\\Tests\\": "tests/"
    },
    "files": [
      "tests/Support/FrankenGrpcExtensionStubs.php",
      "tests/Support/GrpcLiteExtensionStubs.php"
    ]
  },
  "scripts": {
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "lint": [
      "phpstan analyse --memory-limit=1G",
      "phpcs"
    ],
    "test": "phpunit --testsuite unit",
    "test:franken-smoke": "tools/franken-smoke.sh",
    "test:franken-spanner-smoke": "tools/franken-smoke.sh --testsuite franken-spanner-smoke",
    "test:native-smoke": "php -d extension=grpc.so vendor/bin/phpunit --testsuite native-smoke",
    "test:pubsub-smoke": "php -d extension=grpc.so vendor/bin/phpunit --testsuite pubsub-smoke",
    "test:spanner-smoke": "tools/spanner-smoke.sh",
    "test:coverage": "XDEBUG_MODE=coverage phpunit --testsuite unit --coverage-text",
    "validate-project": "composer validate --strict",
    "verify": [
      "@validate-project",
      "@lint",
      "@test:coverage",
      "@test:native-smoke"
    ],
    "verify:smoke": [
      "@test:franken-smoke",
      "@test:native-smoke",
      "@test:pubsub-smoke",
      "@test:spanner-smoke"
    ]
  }
}
