{
  "name": "dkkoma/php-grpc-lite-gax",
  "description": "GAX TransportInterface adapter foundation with a FrankenPHP grpc-go backend.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "google/gax": "^1.42"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "GrpcLiteGax\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GrpcLiteGax\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "lint": [
      "phpstan analyse",
      "phpcs"
    ],
    "test": "phpunit",
    "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-text",
    "validate-project": "composer validate --strict"
  }
}
