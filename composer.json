{
  "name": "dkkoma/php-grpc-lite-gax",
  "description": "GAX TransportInterface adapters for FrankenPHP grpc-go and php-grpc-lite.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "google/gax": "^1.42"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "GrpcLiteGax\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GrpcLiteGax\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "phpstan analyse",
    "test": "phpunit"
  }
}
