+    private function hasInsecureCredentials(array $transportConfig): bool
+    {
+        if (!class_exists(ChannelCredentials::class)) {
+            return false;
+        }
+
+        $credentials = $transportConfig['stubOpts']['credentials'] ?? null;
+        if (!is_object($credentials)) {
+            return false;
+        }
+
+        return $credentials == ChannelCredentials::createInsecure();
